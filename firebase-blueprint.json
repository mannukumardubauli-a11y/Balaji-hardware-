    "users": {
      "title": "User Profile",
      "description": "App users and role definition",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "shopSettings": {
      "title": "Shop Settings",
      "description": "Shop details for invoices",
      "properties": {
        "shopName": { "type": "string" },
        "tagline": { "type": "string" },
        "phone": { "type": "string" },
        "gstin": { "type": "string" },
        "address": { "type": "string" },
        "logoUrl": { "type": "string" },
        "terms": { "type": "string" }
      }
