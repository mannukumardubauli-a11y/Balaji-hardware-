{
  "entities": {
    "items": {
      "title": "Inventory Item",
      "description": "Hardware shop inventory items",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "rackLocation": { "type": "string" },
        "unit": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "currentStock": { "type": "number" },
        "lowStockThreshold": { "type": "number" },
        "barcode": { "type": "string" },
        "supplierId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "category", "rackLocation", "unit", "sellingPrice", "currentStock"]
    },
    "bills": {
      "title": "Sales Bill",
      "description": "Billing invoice history",
      "properties": {
