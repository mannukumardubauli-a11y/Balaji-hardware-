        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "gstPercent": { "type": "number" },
        "gstAmount": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "paymentMode": { "type": "string" },
        "cashierName": { "type": "string" },
        "cashierId": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["billNumber", "items", "total", "paymentMode", "timestamp"]
    },
    "suppliers": {
      "title": "Supplier",
      "description": "Hardware suppliers directory",
      "properties": {
        "name": { "type": "string" },
        "contactPerson": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "categories": { "type": "array" },
        "notes": { "type": "string" }
      },
      "required": ["name", "phone"]
    },
    "udhaar": {
      "title": "Udhaar Credit Ledger",
      "description": "Customer credit tracking",
      "properties": {
        "customerName": { "type": "string" },
