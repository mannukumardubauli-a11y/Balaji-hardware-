rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Inventory items collection
    match /items/{itemId} {
      allow read, write: if true;
    }

    // Bills / Sales transactions
    match /bills/{billId} {
      allow read, write: if true;
    }

    // Suppliers Directory
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    // Udhaar / Credit Accounts
    match /udhaar/{udhaarId} {
      allow read, write: if true;
    }

    // Sales Returns
    match /salesReturns/{returnId} {
      allow read, write: if true;
    }

    // Shop Branding Settings
    match /shopSettings/{settingId} {
      allow read, write: if true;
    }

    // Low stock pending orders
    match /low_stock/{orderId} {
      allow read, write: if true;
    }

    // User accounts and security profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Default match for any other document
    match /{document=**} {
      allow read, write: if true;
    }
  }
}



